{
  "type": "project",
  "license": "proprietary",
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require": {
    "php": ">=8.4",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "api-platform/core": "^4.3",
    "doctrine/dbal": "^4.2",
    "doctrine/doctrine-bundle": "^3.2",
    "doctrine/doctrine-migrations-bundle": "^4.0",
    "doctrine/orm": "^3.4",
    "gesdinet/jwt-refresh-token-bundle": "^2.0",
    "lexik/jwt-authentication-bundle": "^3.1",
    "nelmio/cors-bundle": "^2.5",
    "symfony/asset": "^8.0",
    "symfony/console": "^8.0",
    "symfony/doctrine-messenger": "^8.0",
    "symfony/dotenv": "^8.0",
    "symfony/expression-language": "^8.0",
    "symfony/flex": "^2.6",
    "symfony/form": "^8.0",
    "symfony/framework-bundle": "^8.0",
    "symfony/messenger": "^8.0",
    "symfony/runtime": "^8.0",
    "symfony/security-bundle": "^8.0",
    "symfony/serializer": "^8.0",
    "symfony/twig-bundle": "^8.0",
    "symfony/uid": "^8.0",
    "symfony/validator": "^8.0",
    "symfony/yaml": "^8.0",
    "vich/uploader-bundle": "^2.8"
  },
  "require-dev": {
    "api-platform/symfony": "^4.3",
    "phpunit/phpunit": "^12.0",
    "symfony/browser-kit": "^8.0",
    "symfony/css-selector": "^8.0",
    "symfony/http-client": "^8.0",
    "symfony/maker-bundle": "^1.65",
    "symfony/phpunit-bridge": "^8.0"
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true,
      "symfony/flex": true,
      "symfony/runtime": true
    },
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    },
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ],
    "test": "php bin/phpunit",
    "lint:container": "php bin/console lint:container",
    "migrations:migrate": "php bin/console doctrine:migrations:migrate --no-interaction"
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "extra": {
    "symfony": {
      "allow-contrib": true,
      "require": "8.0.*"
    }
  }
}
