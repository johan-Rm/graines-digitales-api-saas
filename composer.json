{
  "name": "graines-digitales/symfony-8-api-platform",
  "description": "Symfony 8 API Platform backend for the Graines Digitales multi-tenant content management API.",
  "type": "project",
  "license": "proprietary",
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require": {
    "php": ">=8.4",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "api-platform/core": "^4.3",
    "doctrine/dbal": "^4.2",
    "doctrine/doctrine-bundle": "^3.2",
    "doctrine/doctrine-migrations-bundle": "^4.0",
    "doctrine/orm": "^3.4",
    "gesdinet/jwt-refresh-token-bundle": "^2.0",
    "lexik/jwt-authentication-bundle": "^3.1",
    "nelmio/cors-bundle": "^2.5",
    "symfony/asset": "^8.0",
    "symfony/console": "^8.0",
    "symfony/doctrine-messenger": "^8.0",
    "symfony/dotenv": "^8.0",
    "symfony/expression-language": "^8.0",
    "symfony/flex": "^2.6",
    "symfony/form": "^8.0",
    "symfony/framework-bundle": "^8.0",
    "symfony/messenger": "^8.0",
    "symfony/runtime": "^8.0",
    "symfony/security-bundle": "^8.0",
    "symfony/serializer": "^8.0",
    "symfony/twig-bundle": "^8.0",
    "symfony/uid": "^8.0",
    "symfony/validator": "^8.0",
    "symfony/yaml": "^8.0",
    "vich/uploader-bundle": "^2.8"
  },
  "require-dev": {
    "api-platform/symfony": "^4.3",
    "deptrac/deptrac": "^2.0",
    "friendsofphp/php-cs-fixer": "^3.95",
    "infection/infection": "^0.33",
    "phpstan/phpstan": "^2.2",
    "phpstan/phpstan-doctrine": "^2.0",
    "phpstan/phpstan-phpunit": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpstan/phpstan-symfony": "^2.0",
    "phpunit/phpunit": "^12.0",
    "rector/rector": "^2.4",
    "symfony/browser-kit": "^8.0",
    "symfony/css-selector": "^8.0",
    "symfony/http-client": "^8.0",
    "symfony/maker-bundle": "^1.65",
    "symfony/phpunit-bridge": "^8.0"
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true,
      "symfony/flex": true,
      "symfony/runtime": true,
      "infection/extension-installer": true
    },
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    },
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ],
    "analyse": "phpstan analyse --memory-limit=1G",
    "cs:check": "php-cs-fixer fix --dry-run --diff --verbose",
    "cs:fix": "php-cs-fixer fix --verbose",
    "deptrac": "deptrac analyse --config-file=deptrac.yaml",
    "infection": "infection --threads=max",
    "quality": [
      "@lint:container",
      "@analyse",
      "@cs:check",
      "@deptrac",
      "@test"
    ],
    "quality:fast": [
      "@lint:container",
      "@analyse",
      "@cs:check",
      "@deptrac"
    ],
    "rector:check": "rector process --dry-run",
    "rector:fix": "rector process",
    "test": "php bin/phpunit",
    "lint:container": "php bin/console lint:container",
    "migrations:migrate": "php bin/console doctrine:migrations:migrate --no-interaction"
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "extra": {
    "symfony": {
      "allow-contrib": true,
      "require": "8.0.*"
    }
  }
}
