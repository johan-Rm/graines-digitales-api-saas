APP_ENV=dev
APP_SECRET=change-me
APP_DEBUG=1
DEFAULT_URI=http://localhost:18080

DATABASE_URL="postgresql://graines_digitales_api:graines_digitales_api@postgres:5432/graines_digitales_api?serverVersion=17&charset=utf8"
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

CORS_ALLOW_ORIGIN="^https?://(localhost|127\\.0\\.0\\.1)(:[0-9]+)?$"

JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change-me
JWT_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=2592000

# Comma-separated platform operator emails. These users receive ROLE_SUPER_ADMIN at runtime.
PLATFORM_SUPER_ADMIN_EMAILS=

API_HTTP_PORT=18080
POSTGRES_PORT=15432
POSTGRES_DB=graines_digitales_api
POSTGRES_USER=graines_digitales_api
POSTGRES_PASSWORD=graines_digitales_api

# Host filesystem path to the webapps base directory (used by docker-compose for the bind mount).
# The container mounts this path at /srv/webapps (set via WEBAPPS_DIR in docker-compose environment).
# MediaObject uploads are written to {WEBAPPS_DIR}/{project.mediaPath}/ inside the container.
# The public URL is configured per-project via project.mediaBaseUrl.
WEBAPPS_HOST_DIR=/path/to/graines-digitales/modern-web-apps
WEBAPPS_DIR=/srv/webapps
SEED_PROJECT_HOST_DIR=/path/to/graines-digitales/seed/webapp
SEED_PROJECT_PATH=/srv/seed/webapp

# Production deployment defaults. Override values in the target environment.
# For api.graines-digitales.online, use:
# APP_ENV=prod
# APP_DEBUG=0
# DEFAULT_URI=https://api.graines-digitales.online
# CORS_ALLOW_ORIGIN=^https://(...domaines-front-autorises...)$
# JWT_SECRET_KEY=/srv/api/config/jwt/private.pem
# JWT_PUBLIC_KEY=/srv/api/config/jwt/public.pem
API_IMAGE=graines-digitales-api:prod
VPS_EDGE_NETWORK=vps_edge
