APP_ENV=dev
APP_SECRET=change-me
APP_DEBUG=1
DEFAULT_URI=http://localhost:18080

DATABASE_URL="postgresql://graines_digitales_api:graines_digitales_api@postgres:5432/graines_digitales_api?serverVersion=17&charset=utf8"
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

CORS_ALLOW_ORIGIN="^https?://(localhost|127\\.0\\.0\\.1)(:[0-9]+)?$"

JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change-me
JWT_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=2592000

# Comma-separated platform operator emails. These users receive ROLE_SUPER_ADMIN at runtime.
PLATFORM_SUPER_ADMIN_EMAILS=

POSTGRES_PASSWORD=graines_digitales_api

# MediaObject uploads are written to /srv/webapps/{project.mediaPath}.
# The public URL is configured per-project via project.mediaBaseUrl.

# Production overrides for api.graines-digitales.online:
# For api.graines-digitales.online, use:
# APP_ENV=prod
# APP_DEBUG=0
# DEFAULT_URI=https://api.graines-digitales.online
# CORS_ALLOW_ORIGIN=^https://(...domaines-front-autorises...)$
# JWT_SECRET_KEY=/srv/api/config/jwt/private.pem
# JWT_PUBLIC_KEY=/srv/api/config/jwt/public.pem
