# ------------------------------------------------------------------------------
# Template d'environnement de l'API Symfony.
#
# Modèle de copie (mêmes conventions que la webapp) :
#   cp .env.example .env           # dev local
#   cp .env.example .env.preprod   # préprod (docker-compose.prod.yml --env-file .env.preprod)
#   cp .env.example .env.prod      # prod    (docker-compose.prod.yml --env-file .env.prod)
#
# .env / .env.preprod / .env.prod sont gitignorés (seul .env.example est versionné).
#
# Rappels Symfony :
# - en dev, Symfony lit .env via son Dotenv (code monté en volume) ;
# - en preprod/prod, le compose pose disable_dotenv=true : toutes les valeurs viennent
#   du bloc environment: interpolé depuis le --env-file. Les variables ci-dessous
#   alimentent cette interpolation.
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------

APP_ENV=dev
APP_SECRET=change-me
APP_DEBUG=1
DEFAULT_URI=http://localhost:18080

# ------------------------------------------------------------------------------
# Base de données / Messenger
# ------------------------------------------------------------------------------

DATABASE_URL="postgresql://graines_digitales_api:graines_digitales_api@postgres:5432/graines_digitales_api?serverVersion=17&charset=utf8"
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# ------------------------------------------------------------------------------
# CORS
# ------------------------------------------------------------------------------

CORS_ALLOW_ORIGIN="^https?://(localhost|127\\.0\\.0\\.1)(:[0-9]+)?$"

# ------------------------------------------------------------------------------
# JWT (lexik)
# ------------------------------------------------------------------------------

JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change-me
JWT_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=2592000

# ------------------------------------------------------------------------------
# Plateforme
# ------------------------------------------------------------------------------

# Emails opérateurs (séparés par une virgule) — reçoivent ROLE_SUPER_ADMIN au runtime.
PLATFORM_SUPER_ADMIN_EMAILS=

# ------------------------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------------------------

POSTGRES_DB=graines_digitales_api
POSTGRES_USER=graines_digitales_api
POSTGRES_PASSWORD=graines_digitales_api

# ------------------------------------------------------------------------------
# Infrastructure / Docker Compose (toutes ont déjà un défaut dans les compose)
# ------------------------------------------------------------------------------

# Dev (docker-compose.yml) : port HTTP nginx, port hôte Postgres, montages.
API_HTTP_PORT=18080
POSTGRES_PORT=15432
WEBAPPS_HOST_DIR=/srv/webapps
SEED_PROJECT_HOST_DIR=/srv/seed/webapp

# Preprod / Prod (docker-compose.prod.yml) : tag image + réseau edge externe.
API_IMAGE=graines-digitales-api:prod
VPS_EDGE_NETWORK=edge-net

# MediaObject : uploads écrits dans /srv/webapps/{project.mediaPath} ;
# l'URL publique est configurée par projet via project.mediaBaseUrl.

# ------------------------------------------------------------------------------
# Overrides preprod / prod (à reporter dans .env.preprod / .env.prod)
# ------------------------------------------------------------------------------
# APP_ENV=prod
# APP_DEBUG=0
# DEFAULT_URI=https://api.graines-digitales.online
# CORS_ALLOW_ORIGIN=^https://(...domaines-front-autorises...)$
# JWT_SECRET_KEY=/srv/api/config/jwt/private.pem
# JWT_PUBLIC_KEY=/srv/api/config/jwt/public.pem
# APP_SECRET=<secret-fort-genere>
# JWT_PASSPHRASE=<passphrase-forte>
# POSTGRES_PASSWORD=<mot-de-passe-fort>
