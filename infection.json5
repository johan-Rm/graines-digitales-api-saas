{
  "$schema": "vendor/infection/infection/resources/schema.json",
  "source": {
    "directories": [
      "src"
    ],
    "excludes": [
      "Kernel.php"
    ]
  },
  "logs": {
    "text": "var/infection/infection.log",
    "summary": "var/infection/summary.log"
  },
  "mutators": {
    "@default": true
  },
  "testFramework": "phpunit",
  "testFrameworkOptions": "--configuration=phpunit.xml.dist",
  "minMsi": 70,
  "minCoveredMsi": 80,
  "timeout": 10
}
