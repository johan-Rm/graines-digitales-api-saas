.PHONY: dev-setup dev-deploy dev-reset-cache dev-bootstrap-manual dev-fixtures-test dev-seed-load dev-create-super-admin dev-create-organization dev-db-test-create
.PHONY: dev-up dev-up-build dev-down dev-stop dev-restart dev-clean dev-status dev-logs dev-logs-api dev-shell
.PHONY: dev-console dev-composer dev-install dev-update-lock dev-cache-clear dev-jwt dev-migrate

DEV_API_PORT   ?= 18080
DEV_HEALTH_URL ?= http://localhost:$(DEV_API_PORT)/api/docs.jsonld

# COMPOSE_DEV est défini dans le Makefile de base (-f docker-compose.dev.yml).
TAIL ?= 200
FOLLOW ?= -f

# ----------------------------
# Cycle de vie (dev)
# ----------------------------

dev-up: ## Démarrer les services dev (api, nginx, postgres).
	$(COMPOSE_DEV) up -d

dev-up-build: ## Démarrer les services dev avec rebuild.
	$(COMPOSE_DEV) up -d --build

dev-down: ## Arrêter et supprimer les containers dev.
	$(COMPOSE_DEV) down

dev-stop: ## Stopper les containers dev sans les supprimer.
	$(COMPOSE_DEV) stop

dev-restart: dev-down dev-up ## Redémarrer les services dev.

dev-clean: ## down + suppression des volumes (reset complet : efface la BDD dev).
	$(COMPOSE_DEV) down -v --remove-orphans

dev-status: ## Afficher l'état des services dev.
	$(COMPOSE_DEV) ps

dev-logs: ## Suivre les logs dev.
	$(COMPOSE_DEV) logs $(FOLLOW) --tail=$(TAIL)

dev-logs-api: ## Suivre les logs du container api dev.
	$(COMPOSE_DEV) logs $(FOLLOW) --tail=$(TAIL) $(API_SERVICE)

dev-shell: ## Ouvrir un shell dans le container api dev.
	$(COMPOSE_DEV) exec $(API_SERVICE) sh

# ----------------------------
# Setup / Bootstrap
# ----------------------------

dev-setup: dev-up dev-install dev-jwt dev-migrate ## Bootstrap the local Docker development environment.

dev-deploy: dev-setup dev-bootstrap-manual ## One-shot dev : setup + bootstrap manuel + healthcheck.
	@curl -fsS -o /dev/null -w 'dev: HTTP %{http_code}\n' $(DEV_HEALTH_URL) || echo "dev: API pas encore joignable sur $(DEV_HEALTH_URL)"

dev-reset-cache: ## Remove Symfony var/cache from inside the API container.
	$(EXEC) rm -rf var/cache

dev-bootstrap-manual: ## Run the manual bootstrap command. Usage: make dev-bootstrap-manual PASSWORD=password1234
	@test -n "$(PASSWORD)" || (echo 'Missing PASSWORD. Usage: make dev-bootstrap-manual PASSWORD=password1234' && exit 1)
	$(EXEC) php bin/console app:bootstrap:manual --password=$(PASSWORD) $(if $(PROJECT),--project=$(PROJECT))

dev-fixtures-test: ## Load test fixtures through the project command.
	$(EXEC) php bin/console app:fixtures:load-test

dev-seed-load: ## Load project seed data. Usage: make dev-seed-load PROJECT=showcase-immobilier PASSWORD=password1234
	@test -n "$(PROJECT)" || (echo 'Missing PROJECT. Usage: make dev-seed-load PROJECT=showcase-immobilier PASSWORD=password1234' && exit 1)
	@test -n "$(PASSWORD)" || (echo 'Missing PASSWORD. Usage: make dev-seed-load PROJECT=showcase-immobilier PASSWORD=password1234' && exit 1)
	$(EXEC) php bin/console app:bootstrap:manual --password=$(PASSWORD) --project=$(PROJECT) --password-project=$(PROJECT)
	$(EXEC) php bin/console app:seed:load-project $(PROJECT)

dev-create-super-admin: ## Create or update a super admin. Usage: make dev-create-super-admin EMAIL=user@example.test PASSWORD=password1234
	@test -n "$(EMAIL)" || (echo 'Missing EMAIL. Usage: make dev-create-super-admin EMAIL=user@example.test PASSWORD=password1234' && exit 1)
	@test -n "$(PASSWORD)" || (echo 'Missing PASSWORD. Usage: make dev-create-super-admin EMAIL=user@example.test PASSWORD=password1234' && exit 1)
	$(EXEC) php bin/console app:user:create-super-admin $(EMAIL) --password=$(PASSWORD)

dev-create-organization: ## Create an organization. Usage: make dev-create-organization NAME="Org" OWNER_EMAIL=user@example.test OWNER_PASSWORD=password1234
	@test -n "$(NAME)" || (echo 'Missing NAME. Usage: make dev-create-organization NAME="Org" OWNER_EMAIL=user@example.test OWNER_PASSWORD=password1234' && exit 1)
	@test -n "$(OWNER_EMAIL)" || (echo 'Missing OWNER_EMAIL. Usage: make dev-create-organization NAME="Org" OWNER_EMAIL=user@example.test OWNER_PASSWORD=password1234' && exit 1)
	@test -n "$(OWNER_PASSWORD)" || (echo 'Missing OWNER_PASSWORD. Usage: make dev-create-organization NAME="Org" OWNER_EMAIL=user@example.test OWNER_PASSWORD=password1234' && exit 1)
	$(EXEC) php bin/console app:organization:create "$(NAME)" --owner-email=$(OWNER_EMAIL) --owner-password=$(OWNER_PASSWORD)

dev-db-test-create: ## Create the test database if it does not exist.
	$(EXEC) php bin/console doctrine:database:create --if-not-exists --env=test

# ----------------------------
# Opérations dev liées à l'environnement (conteneur dev : $(EXEC))
# Équivalents non déployables des cibles preprod-/prod-.
# ----------------------------

dev-console: ## Console Symfony en dev. Usage: make dev-console CMD="debug:router"
	@test -n "$(CMD)" || (echo 'Missing CMD. Usage: make dev-console CMD="debug:router"' && exit 1)
	$(EXEC) php bin/console $(CMD)

dev-composer: ## Commande Composer en dev. Usage: make dev-composer CMD="show --direct"
	@test -n "$(CMD)" || (echo 'Missing CMD. Usage: make dev-composer CMD="show --direct"' && exit 1)
	$(EXEC) composer $(CMD)

dev-install: ## Installer les dépendances Composer dans le conteneur dev.
	$(EXEC) composer install

dev-update-lock: ## Rafraîchir composer.lock sans changer les versions.
	$(EXEC) composer update --lock --no-scripts

dev-cache-clear: ## Vider le cache Symfony (cache:clear) en dev.
	$(EXEC) php bin/console cache:clear

dev-jwt: ## Générer le keypair JWT s'il manque (dev).
	$(EXEC) php bin/console lexik:jwt:generate-keypair --skip-if-exists

dev-migrate: ## Jouer les migrations Doctrine en dev.
	$(EXEC) php bin/console doctrine:migrations:migrate --no-interaction

.PHONY: dev-setup-showcase
dev-setup-showcase: ## Setup Showcase only. Usage: make dev-setup-showcase PASSWORD=demo1234
	@test -n "$(PASSWORD)" || (echo "Missing PASSWORD" && exit 1)
	$(MAKE) dev-setup
	$(MAKE) dev-seed-load PROJECT=showcase-immobilier PASSWORD=$(PASSWORD)
