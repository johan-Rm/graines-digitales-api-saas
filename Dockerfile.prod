# PHP2Shell : version minimale corrigee pour la branche PHP 8.4.
FROM php:8.4.27-fpm-alpine

RUN apk add --no-cache \
        acl \
        autoconf \
        bash \
        g++ \
        git \
        icu-dev \
        imagemagick \
        imagemagick-dev \
        imagemagick-jpeg \
        imagemagick-webp \
        libpq-dev \
        linux-headers \
        make \
        pkgconfig \
        unzip \
        zlib-dev \
    && docker-php-ext-install intl opcache pdo pdo_pgsql \
    && cd /tmp && git clone --depth 1 https://github.com/Imagick/imagick.git \
    && cd /tmp/imagick && phpize && ./configure && make -j"$(nproc)" && make install \
    && docker-php-ext-enable imagick \
    && rm -rf /tmp/imagick

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

RUN addgroup -g 1000 app && adduser -D -u 1000 -G app app

WORKDIR /srv/api

COPY docker/php/prod.ini /usr/local/etc/php/conf.d/app.ini
COPY docker/php/www.conf /usr/local/etc/php-fpm.d/www.conf

COPY composer.json composer.lock symfony.lock ./
RUN composer install \
        --no-dev \
        --prefer-dist \
        --no-interaction \
        --no-progress \
        --no-scripts

COPY . .

RUN composer dump-autoload --classmap-authoritative --no-dev \
    && mkdir -p config/jwt var/cache var/log public/media \
    && chown -R app:app config/jwt var public/media

USER app

CMD ["php-fpm"]
